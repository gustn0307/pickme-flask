# PostgreSQL connection (replace with the values from your DB provider).
# URL-encode special characters in the password, if needed.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
AUTO_CREATE_DB=false
GEMINI_API_KEY=

# For local SQLite development instead, use:
# DATABASE_URL=sqlite:///pickme.db
# AUTO_CREATE_DB=true

